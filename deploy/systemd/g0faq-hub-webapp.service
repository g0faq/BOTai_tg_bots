[Unit]
Description=g0faq Hub web app
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/tutor-bot
EnvironmentFile=/opt/tutor-bot/.env
Environment=ENV_FILE=/opt/tutor-bot/.env
Environment=PYTHONPATH=/opt/tutor-bot/src
ExecStart=/opt/tutor-bot/.venv/bin/python -m uvicorn tutor_bot.hub.webapp:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
