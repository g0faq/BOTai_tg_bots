[Unit]
Description=Tutor Telegram bot instance %i
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tutorbot
Group=tutorbot
WorkingDirectory=/opt/tutor-bots/app
Environment=PYTHONUNBUFFERED=1
Environment=BOT_RUNTIME=server
Environment=ENV_FILE=/opt/tutor-bots/%i/.env
EnvironmentFile=/opt/tutor-bots/%i/.env
ExecStart=/opt/tutor-bots/app/.venv/bin/python -m tutor_bot.main
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tutor-bots

[Install]
WantedBy=multi-user.target
